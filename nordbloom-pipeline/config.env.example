# Nordbloom pipeline config. setup.sh writes the real config.env by detecting
# installed tools. Edit manually to override.

NORDBLOOM_ROOT="$HOME/nordbloom_pipeline"

# Upscayl CLI (detected from /Applications/Upscayl.app). Fallback: Real-ESRGAN.
UPSCAYL_BIN=""
UPSCAYL_MODELS_DIR=""
UPSCAYL_MODEL_NAME="realesrgan-x4plus"   # alt: "real-esrgan-x4plus"
UPSCAYL_SCALE=4

# Photoshop app bundle name, e.g. "Adobe Photoshop 2024". Used by osascript.
PHOTOSHOP_APP_NAME=""

# Batching and memory
BATCH_SIZE=3
PS_RESTART_SLEEP=10

# Thresholds
MIN_MOCKUPS_OK=8
JPEG_QUALITY=95

# Source folders on Desktop (setup.sh moves these once; after that these vars unused)
DESKTOP_POSTERS_SRC="$HOME/Desktop/Nya bilder test 4st"
DESKTOP_MOCKUPS_SRC="$HOME/Desktop/Mockups"
